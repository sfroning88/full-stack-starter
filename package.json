{
  "name": "my-project",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@my-project/frontend --log-order=stream",
    "build": "turbo run build --filter=@my-project/frontend --log-order=stream",
    "lint": "turbo run lint --filter=@my-project/frontend --log-order=stream",
    "build:app": "pnpm --filter @my-project/frontend run build",
    "type-check": "pnpm --filter @my-project/config --filter @my-project/types --filter @my-project/db --filter @my-project/services --filter @my-project/utils --filter @my-project/auth --filter @my-project/frontend run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "use:local": "node scripts/env-setup.js local",
    "use:prod": "node scripts/env-setup.js prod",
    "redis:up": "./scripts/local-redis.sh up",
    "redis:down": "./scripts/local-redis.sh down",
    "redis:nuke": "./scripts/local-redis.sh nuke",
    "redis:status": "./scripts/local-redis.sh status",
    "db:up": "./scripts/local-db.sh up",
    "db:down": "./scripts/local-db.sh down",
    "db:nuke": "./scripts/local-db.sh nuke",
    "db:status": "./scripts/local-db.sh status",
    "db:generate": "pnpm --filter @my-project/db db:generate",
    "db:migrate": "pnpm --filter @my-project/db db:migrate",
    "db:deploy": "pnpm --filter @my-project/db db:deploy",
    "db:prisma": "pnpm --filter @my-project/db exec prisma",
    "db:studio": "pnpm --filter @my-project/db db:studio",
    "postinstall": "pnpm db:generate",
    "check:python-format": "./scripts/dev/check-python-format.sh",
    "check:migration-safety": "./scripts/cicd/check-migration-safety.sh",
    "check:unit-tests": "./scripts/dev/diff-python-tests.sh",
    "git:pre-commit": "sh scripts/husky/pre-commit.sh",
    "git:pre-push": "sh scripts/husky/pre-push.sh",
    "clean": "./scripts/clean.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.14",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.5.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-ignore"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "*.py": [
      "black"
    ]
  },
  "prisma": {
    "schema": "packages/db/prisma/schema"
  }
}
