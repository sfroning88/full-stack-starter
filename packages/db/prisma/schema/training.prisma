///////////////////////////////////////////////////////////////////////////////////////////
//                                       TRAINING                                        //
///////////////////////////////////////////////////////////////////////////////////////////

enum TrainingSplit {
    train
    validate
    test
    holdout

    @@map("training_split")
    @@schema("ai")
}

enum TrainingSampleSource {
    hephaestus
    licsar
    okada
    llaima
    villarrica

    @@map("training_sample_source")
    @@schema("ai")
}

enum TrainingSignal {
    deformation
    seismic

    @@map("training_signal")
    @@schema("ai")
}

enum TrainingStage {
    pretrain
    lora
    distill
    prune
    quantize

    @@map("training_stage")
    @@schema("ai")
}

enum TrainingStatus {
    pending
    executing
    completed
    failed
    cancelled

    @@map("training_status")
    @@schema("ai")
}

enum TrainingPrecision {
    fp32
    fp16
    int8

    @@map("training_precision")
    @@schema("ai")
}

enum TrainingSeismicLabel {
    vt
    lp
    tr
    tc

    @@map("training_seismic_label")
    @@schema("ai")
}

enum TrainingDeformationLabel {
    positive
    negative
    uncertain

    @@map("training_deformation_label")
    @@schema("ai")
}

enum TrainingWindow {
    hann
    hamming
    blackman
    boxcar
    tukey

    @@map("training_window")
    @@schema("ai")
}

enum TrainingNormalize {
    minmax
    zscore
    percentile
    none

    @@map("training_normalize")
    @@schema("ai")
}

enum TrainingOptimizer {
    adam
    adamw
    sgd
    rmsprop

    @@map("training_optimizer")
    @@schema("ai")
}

enum TrainingRateSchedule {
    constant
    cosine
    step
    linear
    warmupCosine @map("warmup_cosine")

    @@map("training_rate_schedule")
    @@schema("ai")
}

enum TrainingSparsitySchedule {
    linear
    cubic
    oneShot @map("one_shot")

    @@map("training_sparsity_schedule")
    @@schema("ai")
}

enum TrainingPruningCriterion {
    l1Magnitude @map("l1_magnitude")
    l2Magnitude @map("l2_magnitude")
    random
    movement

    @@map("training_pruning_criterion")
    @@schema("ai")
}

enum TrainingQuantizeMethod {
    ptq
    qat

    @@map("training_quantize_method")
    @@schema("ai")
}

enum TrainingDeformationSourceType {
    mogi
    okada

    @@map("training_deformation_source_type")
    @@schema("ai")
}

enum TrainingNoiseModel {
    none
    atmospheric
    turbulent

    @@map("training_noise_model")
    @@schema("ai")
}

model TrainingDeformationClass {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    deformation                 Boolean @default(true)
    seismic                     Boolean @default(true)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    deformations                TrainingDeformation[]

    @@unique([deformation, seismic])
    @@map("training_deformation_class")
    @@schema("ai")
}

model TrainingSeismicClass {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    vt                          Boolean @default(true)
    lp                          Boolean @default(true)
    tr                          Boolean @default(true)
    tc                          Boolean @default(true)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    seismics                    TrainingSeismic[]

    @@unique([vt, lp, tr, tc])
    @@map("training_seismic_class")
    @@schema("ai")
}

model TrainingDeformationSource {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    source                      TrainingDeformationSourceType
    latitude                    Decimal @db.Decimal(9,6)
    longitude                   Decimal @db.Decimal(9,6)
    depthKm                     Decimal @map("depth_km") @db.Decimal(6,3)
    volumeChangeM3              Decimal? @map("volume_change_m3") @db.Decimal(14,2)
    pressureChangePa            Decimal? @map("pressure_change_pa") @db.Decimal(14,2)
    strikeDeg                   Decimal? @map("strike_deg") @db.Decimal(5,2)
    dipDeg                      Decimal? @map("dip_deg") @db.Decimal(5,2)
    lengthKm                    Decimal? @map("length_km") @db.Decimal(6,3)
    widthKm                     Decimal? @map("width_km") @db.Decimal(6,3)
    rakeDeg                     Decimal? @map("rake_deg") @db.Decimal(5,2)
    slipM                       Decimal? @map("slip_m") @db.Decimal(6,3)
    openingM                    Decimal? @map("opening_m") @db.Decimal(6,3)
    poissonsRatio               Decimal @map("poissons_ratio") @default(0.25) @db.Decimal(4,3)
    shearModulusPa              Decimal? @map("shear_modulus_pa") @db.Decimal(14,2)
    losIncidenceDeg             Decimal @map("los_incidence_deg") @db.Decimal(5,2)
    losHeadingDeg               Decimal @map("los_heading_deg") @db.Decimal(6,2)
    wavelengthM                 Decimal @map("wavelength_m") @db.Decimal(6,4)
    noiseModel                  TrainingNoiseModel @map("noise_model") @default(none)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    interferogram               TrainingInterferogram?

    @@map("training_deformation_source")
    @@schema("ai")
}

model TrainingInterferogram {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    source                      TrainingSampleSource
    split                       TrainingSplit
    label                       TrainingDeformationLabel
    frameId                     String? @map("frame_id")
    primaryAt                   DateTime? @map("primary_at") @db.Date
    secondaryAt                 DateTime? @map("secondary_at") @db.Date
    coherenceMean               Decimal? @map("coherence_mean") @db.Decimal(4,3)
    isAugmented                 Boolean @default(false) @map("is_augmented")
    storagePath                 String @map("storage_path")
    
    deformationSourceId         String? @unique @map("deformation_source_id") @db.Uuid
    deformationSource           TrainingDeformationSource? @relation(fields: [deformationSourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    volcanoId                   String? @map("volcano_id") @db.Uuid
    volcano                     Volcano? @relation(fields: [volcanoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    inferences                  InferenceDeformation[]

    @@index([split, source, label], map: "idx_interferogram_by_split")
    @@index([coherenceMean], map: "idx_interferogram_by_coherence_mean")
    @@index([volcanoId], map: "idx_interferogram_by_volcano")
    @@map("training_interferogram")
    @@schema("ai")
}

model TrainingSeismicEvent {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    source                      TrainingSampleSource
    split                       TrainingSplit
    label                       TrainingSeismicLabel
    station                     String @default("LAV")
    recordedAt                  DateTime @map("recorded_at") @db.Timestamptz(6)
    durationS                   Decimal @map("duration_s") @db.Decimal(8,3)
    samplingHz                  Int @map("sampling_hz")
    waveformPath                String @map("waveform_path")
    spectrogramPath             String? @map("spectrogram_path")

    volcanoId                   String? @map("volcano_id") @db.Uuid
    volcano                     Volcano? @relation(fields: [volcanoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    inferences                  InferenceSeismic[]

    @@index([split, source, label], map: "idx_seismic_event_by_split")
    @@index([station, recordedAt(sort: Desc)], map: "idx_seismic_event_by_station")
    @@index([volcanoId, recordedAt(sort: Desc)], map: "idx_seismic_event_by_volcano")
    @@map("training_seismic_event")
    @@schema("ai")
}

model TrainingSeismic {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    nfft                        Int
    hop                         Int
    window                      TrainingWindow
    windowS                     Decimal @map("window_s") @db.Decimal(8,3)
    samplingHz                  Int @map("sampling_hz")
    melBins                     Int @map("mel_bins")
    bandpassLowHz               Decimal @map("bandpass_low_hz") @db.Decimal(5,2)
    bandpassHighHz              Decimal @map("bandpass_high_hz") @db.Decimal(5,2)
    normalize                   TrainingNormalize
    snrMin                      Decimal @map("snr_min") @db.Decimal(6,3)
    
    classId                     String @map("class_id") @db.Uuid
    class                       TrainingSeismicClass @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    contracts                   TrainingContract[]

    @@map("training_seismic")
    @@schema("ai")
}

model TrainingDeformation {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    patchPx                     Int @map("patch_px")
    wrapRad                     Decimal @map("wrap_rad") @db.Decimal(6,5)
    normalize                   TrainingNormalize
    coherenceMin                Decimal @map("coherence_min") @db.Decimal(4,3)

    classId                     String @map("class_id") @db.Uuid
    class                       TrainingDeformationClass @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    contracts                   TrainingContract[]

    @@map("training_deformation")
    @@schema("ai")
}

model TrainingHyperparameterPretrain {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    epochs                      Int @default(50)
    batchSize                   Int @map("batch_size") @default(32)
    learningRate                Float @map("learning_rate") @default(0.001)
    optimizer                   TrainingOptimizer @default(adamw)
    weightDecay                 Decimal @map("weight_decay") @db.Decimal(10,8) @default(0.01)
    lrSchedule                  TrainingRateSchedule @map("lr_schedule") @default(cosine)
    seed                        Int @default(42)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]
    
    @@map("training_hyperparameter_pretrain")
    @@schema("ai")
}

model TrainingTargetModules {  
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    query                       Boolean @default(true)
    key                         Boolean @default(false)
    value                       Boolean @default(true)
    output                      Boolean @default(false)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    hyperparameters             TrainingHyperparameterLora[]

    @@unique([query, key, value, output])
    @@map("training_target_modules")
    @@schema("ai")
}

model TrainingHyperparameterLora {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    rank                        Int @default(8)
    alpha                       Int @default(16)
    dropout                     Float @default(0.1)
    epochs                      Int @default(10)
    learningRate                Float @map("learning_rate") @default(0.0003)
    
    targetModulesId             String @map("target_modules_id") @db.Uuid
    targetModules               TrainingTargetModules @relation(fields: [targetModulesId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]
    
    @@map("training_hyperparameter_lora")
    @@schema("ai")
}

model TrainingHyperparameterDistill {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    temperature                 Float @default(4.0)
    alpha                       Decimal @db.Decimal(4,3) @default(0.7)
    epochs                      Int @default(30)
    batchSize                   Int @map("batch_size") @default(64)
    learningRate                Float @map("learning_rate") @default(0.001)
    studentArchitecture         String @map("student_architecture")
    
    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]
    
    @@map("training_hyperparameter_distill")
    @@schema("ai")
}

model TrainingHyperparameterPrune {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    targetSparsity              Decimal @map("target_sparsity") @db.Decimal(4,3) @default(0.7)
    iterations                  Int @default(5)
    sparsitySchedule            TrainingSparsitySchedule @map("sparsity_schedule") @default(linear)
    finetuneEpochsPerIter       Int @map("finetune_epochs_per_iter") @default(3)
    pruningCriterion            TrainingPruningCriterion @map("pruning_criterion") @default(l1Magnitude)
    
    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]
    
    @@map("training_hyperparameter_prune")
    @@schema("ai")
}

model TrainingHyperparameterQuantize {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    method                      TrainingQuantizeMethod @default(ptq)
    precision                   TrainingPrecision @default(int8)
    calibrationSamples          Int @map("calibration_samples") @default(100)
    accuracyDropThreshold       Decimal @map("accuracy_drop_threshold") @db.Decimal(6,5) @default(0.02)
    qatEpochs                   Int @map("qat_epochs") @default(5)
    qatLearningRate             Float @map("qat_learning_rate") @default(0.001)
    
    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]

    @@map("training_hyperparameter_quantize")
    @@schema("ai")
}

model TrainingContract {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    signal                      TrainingSignal
    notes                       String?
    version                     Int @default(1)

    seismicId                   String? @map("seismic_id") @db.Uuid
    seismic                     TrainingSeismic? @relation(fields: [seismicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    deformationId               String? @map("deformation_id") @db.Uuid
    deformation                 TrainingDeformation? @relation(fields: [deformationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]
    versions                    DatasetVersion[]

    @@unique([signal, version])
    @@map("training_contract")
    @@schema("ai")
}

model TrainingSession {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    signal                      TrainingSignal
    stage                       TrainingStage
    status                      TrainingStatus
    samples                     Int
    seed                        Int
    gitSha                      String? @map("git_sha")
    gitUrl                      String? @map("git_url")
    startedAt                   DateTime? @map("started_at") @db.Timestamptz(6)
    finishedAt                  DateTime? @map("finished_at") @db.Timestamptz(6)
    errorMessage                String? @map("error_message")

    hyperparameterPretrainId    String? @map("hyperparameter_pretrain_id") @db.Uuid
    hyperparameterPretrain      TrainingHyperparameterPretrain? @relation(fields: [hyperparameterPretrainId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    hyperparameterLoraId        String? @map("hyperparameter_lora_id") @db.Uuid
    hyperparameterLora          TrainingHyperparameterLora? @relation(fields: [hyperparameterLoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    hyperparameterDistillId     String? @map("hyperparameter_distill_id") @db.Uuid
    hyperparameterDistill       TrainingHyperparameterDistill? @relation(fields: [hyperparameterDistillId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    hyperparameterPruneId       String? @map("hyperparameter_prune_id") @db.Uuid
    hyperparameterPrune         TrainingHyperparameterPrune? @relation(fields: [hyperparameterPruneId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    hyperparameterQuantizeId    String? @map("hyperparameter_quantize_id") @db.Uuid
    hyperparameterQuantize      TrainingHyperparameterQuantize? @relation(fields: [hyperparameterQuantizeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    contractId                  String @map("contract_id") @db.Uuid
    contract                    TrainingContract @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    versionId                   String @map("version_id") @db.Uuid
    version                     DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    artifact                    ModelArtifact?

    @@index([signal, createdAt(sort: Desc)], map: "idx_training_session_by_recency")
    @@index([signal, stage, status], map: "idx_training_session_by_stage_and_status")
    @@map("training_session")
    @@schema("ai")
}

///////////////////////////////////////////////////////////////////////////////////////////
