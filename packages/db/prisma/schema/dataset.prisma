///////////////////////////////////////////////////////////////////////////////////////////
//                                       DATASET                                         //
///////////////////////////////////////////////////////////////////////////////////////////

model DatasetIngest {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    source                      TrainingSampleSource
    assetCount                  Int @map("asset_count") @default(0)
    status                      TrainingStatus
    startedAt                   DateTime? @map("started_at") @db.Timestamptz(6)
    finishedAt                  DateTime? @map("finished_at") @db.Timestamptz(6)
    errorMessage                String? @map("error_message")

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)  
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@index([source, status], map: "idx_dataset_ingest_by_source")
    @@map("dataset_ingest") 
    @@schema("ai")
}

model DatasetVersion {
    id                          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    transformHash               String @map("transform_hash") @db.VarChar(64)
    manifestPath                String @map("manifest_path")
    shardCount                  Int @map("shard_count")
    sampleCount                 Int @map("sample_count")
    status                      TrainingStatus

    contractId                  String @map("contract_id") @db.Uuid
    contract                    TrainingContract @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)  
    updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    sessions                    TrainingSession[]

    @@index([transformHash, createdAt(sort: Desc)], map: "idx_dataset_version_by_transform_hash")
    @@unique([contractId, transformHash])
    @@map("dataset_version") 
    @@schema("ai")
}

